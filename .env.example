# Lumio server configuration — copy to .env and fill in.
# Without these, Lumio still works: hosts paste stream keys manually.

# Public origin of this Lumio server (must match OAuth redirect URIs exactly)
PUBLIC_URL=https://your-lumio-domain.com

# --- One-click "Connect YouTube" ---------------------------------------
# Google Cloud Console → create project → enable "YouTube Data API v3"
# → OAuth consent screen (external) → Credentials → OAuth client ID (Web)
# → authorized redirect URI:  {PUBLIC_URL}/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- One-click "Connect Facebook" --------------------------------------
# Meta for Developers → create app (type: Business) → add "Facebook Login"
# → Valid OAuth redirect URI:  {PUBLIC_URL}/auth/facebook/callback
# Permissions used: publish_video, pages_show_list, pages_manage_posts,
# pages_read_engagement (App Review required for non-testers to go live)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Optional ----------------------------------------------------------
# PORT=3000
# FFMPEG_PATH=/usr/bin/ffmpeg
# HLS_DIR=./.hls
# DATA_DIR=./.data
